# Google Gemini API keys used by vision.py
GEMINI_API_KEY_SEARCH=your_gemini_api_key_here
GEMINI_API_KEY_LOCATION=your_gemini_api_key_here

# Absolute path to a Firebase Admin SDK service-account JSON file.
# Keep that JSON file OUTSIDE this repository.
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json
